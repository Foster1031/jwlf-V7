echo Any FAILED lines above: fetch those URLs manually (see images-manifest.md).
pause
exit /b

:fetch
set /a N+=1
if exist %1 (
  set /a SKIP+=1
  exit /b
)
if not exist "%~dp1" mkdir "%~dp1"
echo [!N!/%TOTAL%] %~1
curl -f -s -S -L --retry 2 --connect-timeout 10 --max-time 120 -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64)" -o %1 %2
if errorlevel 1 (
  echo    FAILED: %~2
  if exist %1 del %1
  set /a FAIL+=1
) else (
  set /a OK+=1
)
exit /b
